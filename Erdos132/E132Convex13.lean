/-- `n = 13`: no ordinal counterexample with `≤ 7` colours (`bv_decide`, ~8 min total; the
trimmed LRAT proof is ~97 MB, so it is not pinned). -/
theorem bvNoCE13 : BVNoCE 13 7 pairs13 quads13 := by
  intro x h1 h2 h3
  simp only [pairs13, quads13, List.forall_mem_cons, List.mem_nil_iff, false_imp_iff,
    implies_true, QBV, rareSumBV, rareBV, cntBV, List.foldr_cons, List.foldr_nil, List.range_succ,
    List.range_zero, List.nil_append, List.cons_append, and_true] at h1 h2 h3
  bv_decide (config := { timeout := 2700 })

theorem ordNoCE13 : OrdNoCE 13 7 :=
  ordNoCE_of_bv (by decide +kernel) (by decide +kernel) (by decide) (by decide) (by decide)
    bvNoCE13

/-- **Theorem 13.** A strictly convex 13-gon has at least three distances occurring at most 13
times. -/
theorem erdos132_convex13 (p : Fin 13 → Pt) (hp : StrictConvexPolygon p) :
    3 ≤ (rareDists p).card :=
  main_of_ord (Dm := 7) hp (by decide) ordNoCE13

/-- **Theorem 13 (point sets).** Thirteen points in convex position determine at least three
distances that each occur for at least one and at most 13 of the 78 pairs. -/
theorem erdos132_convex13_finset (S : Finset Pt) (hn : S.card = 13)
    (hS : ConvexIndependent ℝ ((↑) : S → Pt)) : 3 ≤ (rareDistsS S).card :=
  finset_of_polygon erdos132_convex13 hn hS

end Erdos132Convex

